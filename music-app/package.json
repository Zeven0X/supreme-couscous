{
  "name": "tune-forge",
  "productName": "Tune Forge",
  "version": "1.0.0",
  "description": "Offline music editor: turn videos into MP3, change speed, pitch, volume and fades, save with covers.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win nsis portable",
    "dist:dir": "electron-builder --win dir"
  },
  "dependencies": {
    "ffmpeg-static": "5.2.0"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.zeven.tuneforge",
    "productName": "Tune Forge",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "lib/**", "renderer/**", "package.json", "!**/*.map"],
    "asarUnpack": ["node_modules/ffmpeg-static/**"],
    "win": {
      "icon": "build/icon.png",
      "target": ["nsis", "portable"],
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Tune Forge",
      "artifactName": "Tune-Forge-Setup-${version}.${ext}"
    },
    "portable": { "artifactName": "Tune-Forge-Portable-${version}.${ext}" }
  }
}
