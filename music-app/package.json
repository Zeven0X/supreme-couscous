{
  "name": "tonix",
  "productName": "Tonix",
  "version": "1.1.0",
  "description": "Tonix: offline music app with song maps, sound effects, covers and MP3 export.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win nsis portable",
    "dist:dir": "electron-builder --win dir"
  },
  "dependencies": {
    "ffmpeg-static": "5.2.0"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.zeven.tonix",
    "productName": "Tonix",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "lib/**", "renderer/**", "package.json", "!**/*.map"],
    "asarUnpack": ["node_modules/ffmpeg-static/**"],
    "win": {
      "icon": "build/icon.png",
      "target": ["nsis", "portable"],
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Tonix",
      "artifactName": "Tonix-Setup-${version}.${ext}"
    },
    "portable": { "artifactName": "Tonix-Portable-${version}.${ext}" }
  }
}
